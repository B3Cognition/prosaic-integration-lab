# Based on Moby's Apache-2.0 docker-default template at moby/moby@89c5e8fd.
# The OCI policy must retain all default masked paths and keep proc sysctls
# read-only except for the namespaced user limit required by --disable-userns.
abi <abi/4.0>,
include <tunables/global>

profile prosaic-lab-cli-sandbox flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  network,
  capability,
  file,
  userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=prosaic-lab-cli-sandbox,
  ptrace (trace,read,tracedby,readby) peer=prosaic-lab-cli-sandbox,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^ku]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Bubblewrap builds and detaches a private root on the worker's /tmp.
  # Seccomp independently filters the flag sets on both architectures.
  mount options in (slave,rslave,silent) -> /,
  mount fstype=tmpfs options in (rw,nodev,nosuid) -> /tmp/,
  mount options in (bind,rbind,silent) /tmp/newroot/ -> /tmp/newroot/,
  mount options in (bind,rbind,silent) /oldroot/proc/ -> /proc/,
  mount options in (bind,rbind,silent) /oldroot/{tmp/**,srv/lab/**,usr/bin/**,usr/lib{,64}/**,usr/local/**,etc/ld.so.cache,dev/null,dev/urandom} -> /newroot/**,
  remount options in (bind,ro,nosuid,nodev,noexec,noatime,nodiratime,relatime,silent) /newroot/**,
  mount options in (private,rprivate,silent) -> /oldroot/,
  umount /{oldroot/,},
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
}
