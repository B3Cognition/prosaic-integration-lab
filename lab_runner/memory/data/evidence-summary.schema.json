{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "indexComplete", "authority", "requiredFacts", "facts", "excludedRecords", "records"],
  "properties": {
    "version": {"const": 1},
    "indexComplete": {"const": true},
    "authority": {"$ref": "#/$defs/identifier"},
    "requiredFacts": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "facts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
    "excludedRecords": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["recordId", "reason"],
      "properties": {"recordId": {"$ref": "#/$defs/identifier"}, "reason": {"enum": ["wrongAuthority", "superseded"]}}
    }},
    "records": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"},
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["factId", "status", "recordId", "revision", "value"],
      "properties": {
        "factId": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["verified", "absent", "unread"]},
        "recordId": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "revision": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "value": {"type": ["number", "null"]}
      },
      "oneOf": [
        {"properties": {"status": {"const": "verified"}, "recordId": {"type": "string"}, "revision": {"type": "integer"}, "value": {"type": "number"}}},
        {"properties": {"status": {"const": "unread"}, "recordId": {"type": "string"}, "revision": {"type": "integer"}, "value": {"type": "null"}}},
        {"properties": {"status": {"const": "absent"}, "recordId": {"type": "null"}, "revision": {"type": "null"}, "value": {"type": "null"}}}
      ]
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "factId", "authority", "revision", "value"],
      "properties": {
        "recordId": {"$ref": "#/$defs/identifier"}, "factId": {"$ref": "#/$defs/identifier"},
        "authority": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 0, "maximum": 1000000}, "value": {"type": "number"}
      }
    }
  }
}
