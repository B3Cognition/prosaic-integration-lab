include .dockerignore .gitignore AGENTS.md CHANGELOG.md
recursive-include .github/workflows *.yml
recursive-include assets *.yml *.json *.md
include configs/README.md
include configs/qualification.synthetic.json
include configs/alerts.example.yml configs/auth0.example.json configs/oidc.example.json configs/runtime-local.example.yml
include containers/Dockerfile containers/Candidate.Dockerfile
recursive-include dependencies *.json *.lock
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py *.json *.yml *.md
global-exclude __pycache__ *.py[cod]
